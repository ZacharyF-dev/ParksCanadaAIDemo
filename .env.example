# Azure AI Foundry / Azure OpenAI model deployment
# Authenticate locally with `az login`; no API key is required.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_CHAT_MODEL=<your-model-deployment-name>

# Local service endpoints
JIRA_MCP_URL=http://127.0.0.1:8000/mcp/
MINI_JIRA_BACKEND_HOST=127.0.0.1
MINI_JIRA_FRONTEND_HOST=127.0.0.1
JIRA_AGENT_HOST=127.0.0.1
JIRA_AGENT_PORT=8002
KNOWLEDGE_AGENT_HOST=127.0.0.1
KNOWLEDGE_AGENT_PORT=8007
WORKSPACE_AGENT_HOST=127.0.0.1
WORKSPACE_AGENT_PORT=8005

# Local Markdown RAG server. Copy Markdown files to knowledge/ before indexing.
AZURE_OPENAI_EMBEDDING_MODEL=<your-embedding-deployment-name>
RAG_KNOWLEDGE_DIR=knowledge
RAG_CHROMA_DIR=data/rag/chroma
RAG_COLLECTION_NAME=markdown_knowledge
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_EMBED_BATCH_SIZE=8
RAG_EMBED_MAX_RETRIES=5
MARKDOWN_RAG_MCP_URL=http://127.0.0.1:8003/mcp

# Local synthetic PC411-style directory MCP server
PC411_DIRECTORY_DB_PATH=data/pc411_directory.db
PC411_STRUCTURE_PATH=PC411_Structure.html
PC411_DIRECTORY_HOST=127.0.0.1
PC411_DIRECTORY_PORT=8004
PC411_DIRECTORY_SEED=411
PC411_DIRECTORY_MCP_URL=http://127.0.0.1:8004/mcp
